# Copie este archivo a .env y ajuste los valores (cp .env.example .env).

# Orígenes permitidos por CORS: lista JSON o valores separados por comas.
# En producción indique solo el dominio del frontend (nunca "*").
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
# true → una línea JSON por registro (recomendado en producción)
LOG_JSON=false

# dev | prod
ENVIRONMENT=dev

# Modelo de pronóstico: se entrena al iniciar con los hiperparámetros elegidos en la búsqueda.
# ARBOLES_PRONOSTICO reemplaza el número de árboles (vacío = el elegido, 500).
# ARBOLES_PRONOSTICO=
N_JOBS=1

# Puerto publicado por docker-compose
BACKEND_PORT=8000
